# Node environment
NODE_ENV=development
API_PORT=8080
DASHBOARD_PORT=3000

# Database URL: for local zero-config, SQLite is default.
# For PostgreSQL (Docker / Production), set:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smsgateway?schema=public"
DATABASE_URL="file:./dev.db"

# Base URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# Simulator Mode: if true, does not require a physical phone to send SMS. Simulates delivery in background.
SIMULATOR_MODE=true

# Secrets & Keys (Generate 32-byte hex or base64 keys in production)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
OTP_PEPPER=dev-otp-pepper-secret-change-in-prod-123456789
WEBHOOK_SIGNING_KEY=dev-webhook-secret-change-in-prod-987654321
ADMIN_SECRET=dev-admin-secret-key-12345
